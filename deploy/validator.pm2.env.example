# Python executable PM2 should run. Point this at the same venv where tag101 is
# installed.
PYTHON_BIN=/home/user/tag101/.venv/bin/python

# Host paths used directly by the local Python process.
WALLET_HOST_PATH=/home/user/.bittensor/wallets
STATE_HOST_DIR=/home/user/node-state/validator

# The deploy script passes --axon.port and --axon.external_port from this value
# unless later NODE_ARGS or CLI args override them.
AXON_PORT=<VALIDATOR_AXON_PORT>
AXON_EXTERNAL_IP=<VALIDATOR_AXON_EXTERNAL_IP>

# Optional PM2 process flags, for example memory restart limits.
# PM2_START_ARGS=--max-memory-restart 8G

# Base validator args. Fill in endpoint and wallet values before starting. Extra
# CLI args after "--" in pm2_node.py are appended after this value and therefore
# win if an option appears twice.
NODE_ARGS=--netuid 101 --subtensor.network <SUBTENSOR_ENDPOINT> --wallet.name <WALLET_NAME> --wallet.hotkey <HOTKEY_NAME> --logging.info
